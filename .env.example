# Backend comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# React build-time API base URL
VITE_API_URL=http://localhost:8000
# Gemini API Key for RAG Engine (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# PostgreSQL Database Configuration
LOCAL_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/rxnexus_db
DATABASE_URL=postgresql://rxuser:rxpassword@db:5432/rxnexus_db
